# Production values for docker-compose.prod.yml. On the server they live in DEPLOY_PATH/.env
# (chmod 600), next to the compose file. Never commit it.

SITE_DOMAIN=brandonkamga.com
# The release to run, e.g. v0.1.0 (images are published by .github/workflows/release.yml).
IMAGE_TAG=

MONGO_DB=me
MONGO_ROOT_USER=root
# Generate each secret with: openssl rand -base64 32
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=me_api
MONGO_APP_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=
# From backend/: uv run python -m app.auth.hash_password
# Wrap it in single quotes: the hash contains $ signs.
ADMIN_PASSWORD_HASH=''
